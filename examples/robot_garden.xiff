# Robot Garden: a symmetric scene to exercise XIFF geometry.
canvas 800 520
palette #101b2b #eaf4ef #65d6be #ffbd69 #25394b #426477

# Distant stars and a thin celestial arch.
circle x=88 y=68 r=2 color=1
repeat count=7 dx=104
arc x=400 y=265 r=220 start=205 end=270 width=2 color=5
mirror axis=y pivot=400
circle x=400 y=45 r=9 color=3

# Ground and repeated garden lights.
rect x=48 y=440 w=704 h=2 color=5
circle x=100 y=464 r=3 color=2
repeat count=11 dx=60

# The robot uses local coordinates around its vertical centerline.
group name=robot
  # Antenna and ears.
  line x=0 y=-30 length=28 angle=90 width=4 color=2
  circle x=0 y=-34 r=7 color=3
  rect x=-74 y=27 w=14 h=28 color=3
  mirror axis=y pivot=0
  # Head and inset face.
  rect x=-60 y=0 w=120 h=84 color=2
  rect x=-50 y=10 w=100 h=64 color=4
  circle x=-24 y=36 r=10 color=1
  mirror axis=y pivot=0
  circle x=-24 y=36 r=4 color=4
  mirror axis=y pivot=0
  arc x=0 y=48 r=15 start=20 end=160 width=3 color=3
  # Neck and torso.
  rect x=-12 y=84 w=24 h=12 color=3
  rect x=-44 y=96 w=88 h=80 color=2
  rect x=-32 y=108 w=64 h=42 color=4
  circle x=0 y=129 r=12 fill=0 width=3 color=3
  line x=0 y=116 length=13 angle=90 width=3 color=3
  # Curved arms and hands, reflected exactly.
  curve x=-44 y=112 length=48 angle=155 bend_at=24 bend=12 width=8 color=2
  mirror axis=y pivot=0
  circle x=-88 y=132 r=10 color=3
  mirror axis=y pivot=0
  # Legs and shoes.
  rect x=-30 y=176 w=16 h=28 color=2
  mirror axis=y pivot=0
  rect x=-38 y=200 w=30 h=12 color=1
  mirror axis=y pivot=0
end

# A large robot and two half-size companions share one definition.
place name=robot x=400 y=212
place name=robot x=170 y=318 scale=0.5
place name=robot x=630 y=318 scale=0.5

# Symmetric sprouts frame the family.
line x=64 y=438 length=44 angle=-90 width=3 color=2
curve x=64 y=416 length=24 angle=205 bend_at=12 bend=7 width=6 color=2
mirror axis=y pivot=64
line x=736 y=438 length=44 angle=-90 width=3 color=2
curve x=736 y=416 length=24 angle=205 bend_at=12 bend=7 width=6 color=2
mirror axis=y pivot=736
