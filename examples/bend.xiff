canvas 220 120
palette #ffffff #111111 #e94560 #3a86ff

# Base x-axis reference.
line x=20 y=88 length=160 angle=0 width=2 color=2

# A 160px local x-axis curve, pulled upward at x=50 by 42px.
curve x=20 y=88 length=160 bend_at=50 bend=-42 width=7 color=1

# Same idea, rotated.
curve x=42 y=100 length=96 bend_at=35 bend=-24 angle=-35 width=4 color=3
mirror axis=y pivot=110 color=3

# Repeated small waves.
wave x=26 y=22 length=46 amp=5 cycles=1 width=2 color=2
repeat count=4 dx=48
