canvas 300 180
palette #ffffff #111111 #e50914 #4285f4 #fbbc05 #34a853

# Netflix-ish N: built from filled rectangles.
group name=N
  rect x=20 y=24 w=24 h=132 color=2
  rect x=98 y=24 w=24 h=132 color=2
  rect x=26 y=27 w=24 h=140 angle=-20 color=1
end

place name=N x=0 y=0 scale=1

# Google-ish G: arc plus bar, using separate colors to show the idea.
arc x=220 y=88 r=48 start=35 end=330 width=13 color=3
arc x=220 y=88 r=48 start=330 end=410 width=13 color=5
arc x=220 y=88 r=48 start=130 end=220 width=13 color=4
line x=220 y=88 length=38 angle=0 width=13 color=3
line x=249 y=88 length=22 angle=90 width=13 color=3
